# Backend settings. Copy this file to .env, change what you need, and start
# the backend with:
#   uvicorn app.main:app --reload --port 8000 --env-file .env
# A setting already set on the computer (e.g. with setx) wins over .env.
# Lines starting with # are off; the value shown is the default.

# --- Concurrent auto-evaluation -----------------------------------------
# How many submissions "Evaluate a whole assignment" grades at the same time.
# Use the SAME number for Ollama's OLLAMA_NUM_PARALLEL, which is NOT read from
# this file: set it with  setx OLLAMA_NUM_PARALLEL 2  and restart Ollama.
# 6 GB GPU: 1-2 | 12 GB: about 2 | 16-24 GB: 3-4 (measure before raising).
AUTO_EVAL_WORKERS=

# --- Grading model (Ollama) ---------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# Context window and longest reply per grading call, in tokens.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=2000
# 0 gives repeatable marks; 0.7 is the Qwen3 model card's recommendation.
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_PRESENCE_PENALTY=0.5
# auto: Ollama when it is reachable, otherwise the heuristic grader.
# GRADER_BACKEND=auto

# --- Optional features --------------------------------------------------
# Describe video frames with a vision model (auto/on/off).
# VIDEO_VISION=off
# VISION_MODEL=qwen3-vl:4b
# Run student Python code in Docker (docker/off).
# CODE_SANDBOX=off
# AI_TEXT_DETECTION=1
# SEMANTIC_SIMILARITY=1
# CROSS_MODAL_SEMANTIC=1
