# Backend settings. Copy this file to .env, change what you need, and start
# the backend with:
#   uvicorn app.main:app --reload --port 8000 --env-file .env
# A setting already set on the computer (e.g. with setx) wins over .env.
# Lines starting with # are off; the value shown is the default.

# --- Concurrent auto-evaluation -----------------------------------------
# How many submissions "Evaluate a whole assignment" grades at the same time.
# Use the SAME number for Ollama's OLLAMA_NUM_PARALLEL, which is NOT read from
# this file: set it with  setx OLLAMA_NUM_PARALLEL 2  and restart Ollama.
# 6 GB GPU: 1-2 | 12 GB: about 2 | 16-24 GB: 3-4 (measure before raising).
# Must be a whole number: 1 grades one submission at a time.
AUTO_EVAL_WORKERS=1

# --- Grading model (Ollama) ---------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# Context window and longest reply per grading call, in tokens.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=2000
# 0 gives repeatable marks; 0.7 is the Qwen3 model card's recommendation.
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_PRESENCE_PENALTY=0.5
# auto: Ollama when it is reachable, otherwise the heuristic grader.
# GRADER_BACKEND=auto

# --- Optional features --------------------------------------------------
# Describe video frames with a vision model (auto/on/off).
# VIDEO_VISION=off
# VISION_MODEL=qwen3-vl:4b
# AI_TEXT_DETECTION=1
# SEMANTIC_SIMILARITY=1
# Where code embeddings are kept between restarts ("off" = memory only) and its size cap.
# SEMANTIC_CACHE_DIR=cache/unixcoder
# SEMANTIC_CACHE_MAX_MB=500
# CROSS_MODAL_SEMANTIC=1

# --- Code challenges: running student code ------------------------------
# Off by default, because it runs students' programs. To use code challenges
# (instructors' "Tests" button and students' "Run" button):
#   1. Install and start Docker Desktop.
#   2. Download the images once:  docker pull python:3.12-slim
#                                 docker pull ruby:3.3-slim
#   3. Set CODE_SANDBOX=docker below, then restart the backend (it reads this
#      file only at start, and only with --env-file .env).
# Without it, students see "Running code is not available right now." and
# instructors see "Code execution is off. Set CODE_SANDBOX=docker...".
# Python and Ruby are supported. Each test runs in its own container with no
# network, 256 MB of memory, a CPU limit and a time limit.
# CODE_SANDBOX=off
# Seconds each test may run.
# CODE_TEST_TIMEOUT=10
# Docker images used to run the code (Python: CODE_SANDBOX_IMAGE).
# CODE_SANDBOX_IMAGE=python:3.12-slim
# CODE_SANDBOX_RUBY_IMAGE=ruby:3.3-slim
# Students' "Run" button: runs per student per hour, and runs at once on the server.
# CODE_SAMPLE_RUNS_PER_HOUR=10
# CODE_SAMPLE_MAX_PARALLEL=2
